<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon before Android 8 (no adaptive icons): the same artwork on a rounded square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- The adaptive foreground has an 18 dp margin on each side of its 108 dp canvas; crop most of it. -->
    <item android:drawable="@drawable/ic_launcher_fg" android:left="-12dp" android:top="-12dp"
        android:right="-12dp" android:bottom="-12dp" />
</layer-list>
